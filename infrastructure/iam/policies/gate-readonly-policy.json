{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadPipelineInputsAndArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::BIKEPULSE_BUCKET/raw/*",
        "arn:aws:s3:::BIKEPULSE_BUCKET/curated/*",
        "arn:aws:s3:::BIKEPULSE_BUCKET/features/*",
        "arn:aws:s3:::BIKEPULSE_BUCKET/splits/*",
        "arn:aws:s3:::BIKEPULSE_BUCKET/models/experiments/*",
        "arn:aws:s3:::BIKEPULSE_BUCKET/models/selections/*"
      ]
    }
  ]
}
