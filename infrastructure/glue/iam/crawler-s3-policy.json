{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadBucketInformation",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::BIKEPULSE_BUCKET"
      ]
    },
    {
      "Sid": "ReadCuratedParquetOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::BIKEPULSE_BUCKET/curated/dataset=seoul-bike/*"
      ]
    }
  ]
}
