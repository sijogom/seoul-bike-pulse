{
  "family": "bikepulse-dev-monitor-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::AWS_ACCOUNT_ID:role/bikepulse-dev-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::AWS_ACCOUNT_ID:role/bikepulse-dev-monitor-task-role",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "monitor",
      "image": "AWS_ACCOUNT_ID.dkr.ecr.ap-northeast-2.amazonaws.com/bikepulse/monitor:k001",
      "essential": true,
      "environment": [
        {
          "name": "BIKEPULSE_BUCKET",
          "value": "BIKEPULSE_BUCKET"
        },
        {
          "name": "AWS_DEFAULT_REGION",
          "value": "ap-northeast-2"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/bikepulse-dev/monitor",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "command": [
        "python",
        "-u",
        "/app/eda_worker.py"
      ]
    }
  ]
}
